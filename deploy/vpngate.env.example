# /etc/vpngate/vpngate.env  —  修改后执行: vpngate restart

# 管理后台
WEB_HOST=0.0.0.0
WEB_PORT=54345
WEB_USER=admin
WEB_PASS=change-me
# 只允许这些 IP 访问管理后台，逗号分隔，例如 203.0.113.10,198.51.100.0/24 。留空 = 不限制
WEB_ALLOW=

# Shadowsocks 入口: 加密，TCP + UDP 同一端口
SS_HOST=0.0.0.0
SS_PORT=7929
SS_PASSWORD=change-me
SS_METHOD=aes-128-gcm
# 只允许这些来源连接，逗号分隔，例如专线落地机 IP: 203.0.113.10/32 。留空 = 不限制
SS_ALLOW=

# 节点筛选
COUNTRIES=JP
# 隧道协议: udp = 只用原生 UDP (延迟和抖动明显更低，没有 UDP 节点时才退回 TCP) / tcp / auto
TRANSPORT=udp
RESIDENTIAL_ONLY=1
DEEP_TEST_COUNT=6
DEEP_TEST_PARALLEL=3
# 测速下载字节数 (前 1/4 用于让 TCP 提速，不计时)，0 = 不测速
SPEEDTEST_BYTES=4000000
# 真连接测试: 通过每条候选隧道真实请求这个地址 (TCP+TLS+HTTP 都要通)，全部失败的节点不用；
# 失败次数计入丢包，请求耗时中位数作为排名用的延迟。留空 = 不测
CONNECT_TEST_URL=
CONNECT_TEST_COUNT=3
# 热备节点：常驻第二条隧道，主节点故障时立即切换
STANDBY=1
# 选点规则: 速度 >= MIN_MBPS 且丢包 <= 5% 为合格，合格节点中延迟最低者胜出 (都不合格时选最快的)
MIN_MBPS=50
# 出口 IP 保持时间 (分钟)，到期后重新测速测延迟、按规则重选。节点故障时不等待，立即切换
HOLD_MINUTES=90
# 轮换模式: 1 = 每到 HOLD_MINUTES 必换一个本轮没用过的出口 IP；所有节点都用过或不可用时清空记录，重新轮换
ROTATE_NO_REPEAT=0
REFRESH_MINUTES=30

# 健康检查
PROBE_TARGET=1.1.1.1
# 实时监测: 每 MONITOR_INTERVAL 秒对主备各发 5 个 1200 字节探测包
MONITOR_INTERVAL=2
# 主节点最近 30 秒丢包超过此值、且备用明显更干净时，立即切到备用
FAIL_LOSS_PCT=5

# 通过隧道解析域名 (使 CDN 按日本出口调度)
DNS_SERVERS=1.1.1.1,8.8.8.8

DATA_DIR=/var/lib/vpngate

# 通知: 出口 IP 变化、无可用节点、恢复时发送。留空 = 不发
# Webhook: POST JSON {"event":"exit_ip_changed|no_node|recovered","old_ip","new_ip","reason","node","text","time"}
NOTIFY_WEBHOOK=
# Telegram 机器人 (找 @BotFather 创建，chat id 可用 @userinfobot 查)
TG_BOT_TOKEN=
TG_CHAT_ID=
