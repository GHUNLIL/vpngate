# /etc/vpngate/vpngate.env  —  修改后执行: vpngate restart

# 管理后台
WEB_HOST=0.0.0.0
WEB_PORT=54345
WEB_USER=admin
WEB_PASS=change-me

# 代理 (HTTP / HTTPS / SOCKS5 共用一个端口)
PROXY_HOST=0.0.0.0
PROXY_PORT=7928
PROXY_USER=change-me
PROXY_PASS=change-me
# 只允许这些来源连接代理，逗号分隔，例如专线中转机 IP: 203.0.113.10/32 。留空 = 不限制
PROXY_ALLOW=
# Shadowsocks 入口: 加密 + 支持 UDP (游戏、语音、QUIC)。SS_PASSWORD 留空则不启用
SS_PORT=7929
SS_PASSWORD=change-me
SS_METHOD=aes-128-gcm
# 先回复"连接成功"再连上游，每个新连接省一次隧道往返 (~35ms)。目标不可达时客户端会收到连接重置
FAST_CONNECT=1

# 节点筛选
COUNTRIES=JP
# 隧道协议: udp = 只用原生 UDP (延迟和抖动明显更低，没有 UDP 节点时才退回 TCP) / tcp / auto
TRANSPORT=udp
RESIDENTIAL_ONLY=1
DEEP_TEST_COUNT=6
DEEP_TEST_PARALLEL=3
# 测速下载字节数，0 = 不测速
SPEEDTEST_BYTES=10000000
# 热备节点：常驻第二条隧道，主节点故障时立即切换
STANDBY=1
# 选点规则: 速度 >= MIN_MBPS 且丢包 <= 5% 为合格，合格节点中延迟最低者胜出 (都不合格时选最快的)
MIN_MBPS=50
# 出口 IP 保持时间 (分钟)，到期后重新测速测延迟、按规则重选。节点故障时不等待，立即切换
HOLD_MINUTES=90
REFRESH_MINUTES=30

# 健康检查
PROBE_TARGET=1.1.1.1
MONITOR_INTERVAL=5
FAIL_LOSS_PCT=30

# 通过隧道解析域名 (使 CDN 按日本出口调度)
DNS_SERVERS=1.1.1.1,8.8.8.8

DATA_DIR=/var/lib/vpngate
