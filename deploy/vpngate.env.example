# /etc/vpngate/vpngate.env  —  修改后执行: vpngate restart

# 管理后台
WEB_HOST=0.0.0.0
WEB_PORT=54345
WEB_USER=admin
WEB_PASS=change-me

# 代理 (HTTP / HTTPS / SOCKS5 共用一个端口)
PROXY_HOST=0.0.0.0
PROXY_PORT=7928
PROXY_USER=change-me
PROXY_PASS=change-me
# 只允许这些来源连接代理，逗号分隔，例如专线中转机 IP: 203.0.113.10/32 。留空 = 不限制
PROXY_ALLOW=

# 节点筛选
COUNTRIES=JP
RESIDENTIAL_ONLY=1
# TCP 节点评分惩罚 (毫秒)。UDP 没有 TCP-over-TCP 问题，丢包时表现更好
TCP_PENALTY_MS=15
DEEP_TEST_COUNT=6
DEEP_TEST_PARALLEL=3
# 测速下载字节数，0 = 不测速
SPEEDTEST_BYTES=2000000
# 热备节点：常驻第二条隧道，主节点故障时立即切换
STANDBY=1
# 发现明显更好的节点时自动切换 (会改变出口 IP)
AUTO_UPGRADE=0
REFRESH_MINUTES=30

# 健康检查
PROBE_TARGET=1.1.1.1
MONITOR_INTERVAL=5
FAIL_LOSS_PCT=30

# 通过隧道解析域名 (使 CDN 按日本出口调度)
DNS_SERVERS=1.1.1.1,8.8.8.8

DATA_DIR=/var/lib/vpngate
